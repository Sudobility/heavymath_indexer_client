{
  "name": "@sudobility/heavymath_indexer_client",
  "version": "0.0.71",
  "description": "React and React Native compatible client library for Heavymath prediction market indexer API with TypeScript support",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build",
    "test:unit": "vitest run",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "check-all": "bun run lint && bun run typecheck && bun run test:unit"
  },
  "keywords": [
    "indexer",
    "client",
    "react",
    "react-native",
    "typescript",
    "prediction-market",
    "heavymath"
  ],
  "author": "John Huang",
  "license": "BUSL-1.1",
  "peerDependencies": {
    "@sudobility/heavymath_types": "^0.0.40",
    "@sudobility/types": "^1.9.76",
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@sudobility/heavymath_types": "^0.0.40",
    "@sudobility/types": "^1.9.76",
    "@tanstack/react-query": "~5.104.5",
    "@testing-library/dom": "~10.4.2",
    "@testing-library/react": "~16.3.3",
    "@types/node": "~26.6.5",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "@vitest/coverage-v8": "~4.1.12",
    "dotenv": "~18.0.9",
    "eslint": "~10.13.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "eslint-plugin-react": "~7.37.5",
    "eslint-plugin-react-hooks": "~7.1.1",
    "happy-dom": "~20.14.6",
    "prettier": "~3.9.10",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "typescript": "~6.0.3",
    "vite": "~8.3.5",
    "vitest": "~4.1.12",
    "zustand": "~5.0.16"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/heavymath_indexer_client.git"
  }
}
